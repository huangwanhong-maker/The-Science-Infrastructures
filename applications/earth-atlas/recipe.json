{
  "title": "The Earth Atlas's data",
  "about": "The datasets the atlas draws and the products built from them, in the order of applications/earth-atlas/README.md §2. Run with data/acquisition/recipe.py, or from the page's Data panel. The AI forecast (Pangu-Weather) needs the model environment and is run apart.",
  "steps": [
    {"id": "natural-earth-50m", "title": "Natural Earth 1:50 million: coasts, countries, rivers and places",
     "run": ["data/acquisition/fetch.py", "natural-earth-50m"], "done": "data/cache/natural-earth-50m/**/retrieval.json"},
    {"id": "geography", "title": "The map, built from Natural Earth",
     "run": ["data/products/geography.py"], "done": "data/cache/products/geography-ne50m.json"},
    {"id": "ghsl-population", "title": "GHS-POP: where the people of the Earth live, 2025 (JRC, 356 MB)",
     "run": ["data/acquisition/fetch.py", "ghsl-population"], "done": "data/cache/ghsl-population/retrieval.json"},
    {"id": "fields-ghsl-population", "title": "People on a grid of 0.25°",
     "run": ["data/products/population_grid.py"], "done": "data/cache/products/fields-ghsl-population.json"},
    {"id": "natural-earth-10m-admin1", "title": "Natural Earth 1:10 million: states and provinces",
     "run": ["data/acquisition/fetch.py", "natural-earth-10m-admin1"], "done": "data/cache/natural-earth-10m-admin1/retrieval.json"},
    {"id": "regions", "title": "Countries and provinces as regions on a grid of 0.1°",
     "run": ["data/products/regions.py"], "done": ["data/cache/products/regions-countries.json", "data/cache/products/regions-admin1.json"]},

    {"id": "etopo-2022", "title": "ETOPO 2022: relief of land and sea floor",
     "run": ["data/acquisition/fetch.py", "etopo-2022"], "done": "data/cache/etopo-2022/**/retrieval.json"},
    {"id": "fields-etopo-2022", "title": "Relief as a field",
     "run": ["data/products/field_grid.py", "--source", "etopo-2022"], "done": "data/cache/products/fields-etopo-2022-*.json"},

    {"id": "gfs", "title": "GFS: the weather near the surface, analyses and forecast",
     "run": ["data/acquisition/fetch.py", "gfs"], "done": "data/cache/gfs/**/retrieval.json"},
    {"id": "fields-gfs", "title": "GFS as fields",
     "run": ["data/products/field_grid.py", "--source", "gfs"], "done": "data/cache/products/fields-gfs-*.json"},
    {"id": "gfs-levels", "title": "GFS aloft: 850, 500 and 250 hPa, and the whole column",
     "run": ["data/acquisition/fetch.py", "gfs-levels"], "done": "data/cache/gfs-levels/**/retrieval.json"},
    {"id": "fields-gfs-levels", "title": "GFS aloft as fields",
     "run": ["data/products/field_grid.py", "--source", "gfs-levels"], "done": "data/cache/products/fields-gfs-levels-*.json"},
    {"id": "aigfs", "title": "AIGFS: NOAA's AI forecast model",
     "run": ["data/acquisition/fetch.py", "aigfs"], "done": "data/cache/aigfs/**/retrieval.json"},
    {"id": "fields-aigfs", "title": "AIGFS as fields",
     "run": ["data/products/field_grid.py", "--source", "aigfs"], "done": "data/cache/products/fields-aigfs-*.json"},
    {"id": "aigefs", "title": "AIGEFS: NOAA's AI ensemble, mean and spread",
     "run": ["data/acquisition/fetch.py", "aigefs"], "done": "data/cache/aigefs/**/retrieval.json"},
    {"id": "fields-aigefs", "title": "AIGEFS as fields",
     "run": ["data/products/field_grid.py", "--source", "aigefs"], "done": "data/cache/products/fields-aigefs-*.json"},

    {"id": "ecmwf-ifs", "title": "ECMWF IFS: the strongest global model, near the surface and aloft",
     "run": ["data/acquisition/fetch.py", "ecmwf-ifs"], "done": "data/cache/ecmwf-ifs/**/retrieval.json"},
    {"id": "fields-ecmwf-ifs", "title": "ECMWF IFS as fields",
     "run": ["data/products/ecmwf_fields.py", "--source", "ecmwf-ifs"], "done": "data/cache/products/fields-ecmwf-ifs-*.json"},
    {"id": "ecmwf-aifs", "title": "ECMWF AIFS: ECMWF's AI forecast model, open for any use",
     "run": ["data/acquisition/fetch.py", "ecmwf-aifs"], "done": "data/cache/ecmwf-aifs/**/retrieval.json"},
    {"id": "fields-ecmwf-aifs", "title": "ECMWF AIFS as fields",
     "run": ["data/products/ecmwf_fields.py", "--source", "ecmwf-aifs"], "done": "data/cache/products/fields-ecmwf-aifs-*.json"},
    {"id": "ecmwf-ens", "title": "ECMWF ENS: the ensemble's probabilities of heavy rain, strong gusts, warm and cold spells",
     "run": ["data/acquisition/fetch.py", "ecmwf-ens"], "done": "data/cache/ecmwf-ens/**/retrieval.json"},
    {"id": "fields-ecmwf-ens", "title": "ECMWF ENS probabilities as fields",
     "run": ["data/products/ecmwf_fields.py", "--source", "ecmwf-ens"], "done": "data/cache/products/fields-ecmwf-ens-*.json"},

    {"id": "oisst", "title": "OISST: sea-surface temperature",
     "run": ["data/acquisition/fetch.py", "oisst"], "done": "data/cache/oisst/**/retrieval.json"},
    {"id": "fields-oisst", "title": "Sea-surface temperature as a field",
     "run": ["data/products/field_grid.py", "--source", "oisst"], "done": "data/cache/products/fields-oisst-*.json"},
    {"id": "ww3", "title": "WaveWatch III: waves",
     "run": ["data/acquisition/fetch.py", "ww3"], "done": "data/cache/ww3/**/retrieval.json"},
    {"id": "fields-ww3", "title": "Waves as fields",
     "run": ["data/products/field_grid.py", "--source", "ww3"], "done": "data/cache/products/fields-ww3-*.json"},
    {"id": "ncep-r1-climatology", "title": "NCEP/NCAR Reanalysis 1: each month's normal 500 hPa height, for the scores",
     "run": ["data/acquisition/fetch.py", "ncep-r1-climatology"], "done": "data/cache/ncep-r1-climatology/**/retrieval.json"},
    {"id": "archive", "title": "The forecasts' runs, kept to be scored",
     "run": ["data/products/archive.py", "--keep", "scored"], "done": "data/cache/archive/index.json"},
    {"id": "verification", "title": "Scores of the forecasts against analyses, reports and best tracks",
     "run": ["data/products/verification.py"], "done": "data/cache/products/verification-earth-atlas.json"},

    {"id": "usgs-earthquakes", "title": "USGS: earthquakes of the past month",
     "run": ["data/acquisition/fetch.py", "usgs-earthquakes"], "done": "data/cache/usgs-earthquakes/**/retrieval.json"},
    {"id": "events-earthquakes", "title": "Earthquakes as events",
     "run": ["data/products/event_catalog.py"], "done": "data/cache/products/events-usgs-earthquakes-*.json"},
    {"id": "gdacs", "title": "GDACS: disasters of the past month and cyclone tracks",
     "run": ["data/acquisition/fetch.py", "gdacs"], "done": "data/cache/gdacs/**/retrieval.json"},
    {"id": "events-gdacs", "title": "Disasters and cyclone tracks as events and tracks",
     "run": ["data/products/disaster_catalog.py"], "done": ["data/cache/products/events-gdacs-*.json", "data/cache/products/tracks-gdacs-*.json"]},

    {"id": "metar", "title": "METAR: the latest weather reports of about 5,000 aerodromes",
     "run": ["data/acquisition/fetch.py", "metar", "--refresh"], "done": "data/cache/metar/latest/retrieval.json"},
    {"id": "observations-metar", "title": "Weather at aerodromes as observations, the last 24 hours",
     "run": ["data/products/observation_set.py", "metar", "--hours", "24"], "done": "data/cache/products/observations-metar.json"},
    {"id": "ndbc", "title": "NDBC: the latest observations of buoys and coastal stations",
     "run": ["data/acquisition/fetch.py", "ndbc", "--refresh"], "done": "data/cache/ndbc/latest/retrieval.json"},
    {"id": "observations-ndbc", "title": "Buoys and coastal stations as observations, the last 48 hours",
     "run": ["data/products/observation_set.py", "ndbc"], "done": "data/cache/products/observations-ndbc.json"},
    {"id": "ibtracs", "title": "IBTrACS: best tracks of the tropical cyclones of the last week",
     "run": ["data/acquisition/fetch.py", "ibtracs", "--profile", "active", "--refresh"], "done": "data/cache/ibtracs/active/retrieval.json"},
    {"id": "ibtracs-last3years", "title": "IBTrACS: best tracks of the last three years, for verification",
     "run": ["data/acquisition/fetch.py", "ibtracs", "--profile", "last3years"], "done": "data/cache/ibtracs/last3years/retrieval.json"},
    {"id": "tracks-ibtracs", "title": "Best tracks of tropical cyclones as tracks",
     "run": ["data/products/ibtracs_tracks.py"], "done": ["data/cache/products/tracks-ibtracs-active.json", "data/cache/products/tracks-ibtracs-last3years.json"]},

    {"id": "gibs-daily", "title": "Yesterday's Earth from space (VIIRS)",
     "run": ["data/acquisition/fetch.py", "gibs-daily"], "done": "data/cache/gibs-daily/**/retrieval.json"},
    {"id": "imagery-true-colour", "title": "Yesterday's imagery, prepared",
     "run": ["data/products/imagery.py", "--source", "gibs-daily"], "done": "data/cache/products/imagery-true-colour.json"},
    {"id": "gibs-static-blue-marble", "title": "Blue Marble: the Earth by day, without clouds",
     "run": ["data/acquisition/fetch.py", "gibs-static", "--profile", "blue-marble"], "done": "data/cache/gibs-static/blue-marble/retrieval.json"},
    {"id": "imagery-blue-marble", "title": "Blue Marble, prepared",
     "run": ["data/products/imagery.py", "--source", "gibs-static", "--profile", "blue-marble"], "done": "data/cache/products/imagery-blue-marble.json"},
    {"id": "gibs-static-black-marble", "title": "Black Marble: the Earth at night",
     "run": ["data/acquisition/fetch.py", "gibs-static", "--profile", "black-marble"], "done": "data/cache/gibs-static/black-marble/retrieval.json"},
    {"id": "imagery-night-lights", "title": "Black Marble, prepared",
     "run": ["data/products/imagery.py", "--source", "gibs-static", "--profile", "black-marble"], "done": "data/cache/products/imagery-night-lights.json"},
    {"id": "gibs-relief", "title": "Shaded relief for detail at close range",
     "run": ["data/acquisition/fetch.py", "gibs-relief"], "done": "data/cache/gibs-relief/**/retrieval.json"},
    {"id": "imagery-relief-shading", "title": "Shaded relief, prepared",
     "run": ["data/products/imagery.py", "--source", "gibs-relief"], "done": "data/cache/products/imagery-relief-shading.json"},

    {"id": "worldbank-indicators", "title": "World Bank: population by country",
     "run": ["data/acquisition/fetch.py", "worldbank-indicators", "--profile", "population"], "done": "data/cache/worldbank-indicators/population/retrieval.json"},
    {"id": "indicators", "title": "Indicators joined to countries",
     "run": ["data/products/country_indicators.py"], "done": "data/cache/products/indicator-*.json"},

    {"id": "koppen-geiger", "title": "Köppen–Geiger climate classes, 1901–2099",
     "run": ["data/acquisition/fetch.py", "koppen-geiger"], "done": "data/cache/koppen-geiger/**/retrieval.json"},
    {"id": "classes-koppen-geiger", "title": "Climate classes as rasters",
     "run": ["data/products/class_raster.py", "--source", "koppen-geiger"], "done": "data/cache/products/classes-koppen-geiger-*.json"},
    {"id": "terraclimate-normals", "title": "TerraClimate: climate normals, 1991–2020",
     "run": ["data/acquisition/fetch.py", "terraclimate-normals"], "done": "data/cache/terraclimate-normals/**/retrieval.json"},
    {"id": "fields-terraclimate-normals", "title": "Climate normals as fields",
     "run": ["data/products/field_grid.py", "--source", "terraclimate-normals"], "done": "data/cache/products/fields-terraclimate-normals-*.json"},

    {"id": "pb2002", "title": "PB2002: the tectonic plates",
     "run": ["data/acquisition/fetch.py", "pb2002"], "done": "data/cache/pb2002/**/retrieval.json"},
    {"id": "plates", "title": "The plates and their motion",
     "run": ["data/products/plate_model.py"], "done": "data/cache/products/plates-pb2002.json"},
    {"id": "ngl-midas", "title": "Nevada Geodetic Laboratory: GPS station velocities",
     "run": ["data/acquisition/fetch.py", "ngl-midas"], "done": "data/cache/ngl-midas/**/retrieval.json"},
    {"id": "stations", "title": "Station velocities, prepared",
     "run": ["data/products/station_velocities.py"], "done": "data/cache/products/stations-ngl-midas.json"},
    {"id": "gcmt", "title": "Global CMT: earthquake mechanisms",
     "run": ["data/acquisition/fetch.py", "gcmt"], "done": "data/cache/gcmt/**/retrieval.json"},
    {"id": "mechanisms", "title": "Mechanisms as events",
     "run": ["data/products/mechanism_catalog.py"], "done": "data/cache/products/events-gcmt.json"},
    {"id": "crust1", "title": "CRUST1.0: the crust",
     "run": ["data/acquisition/fetch.py", "crust1"], "done": "data/cache/crust1/**/retrieval.json"},
    {"id": "crust", "title": "The crust, prepared",
     "run": ["data/products/crust_model.py"], "done": "data/cache/products/crust-crust1.json"}
  ]
}
